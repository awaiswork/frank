# Copy to .env for local development. All values below are dev defaults.
ENV=dev
DATABASE_URL=postgresql+psycopg://frank:frank@localhost:5433/frank
SECRET_KEY=dev-secret-change-me-in-production-please
# Comma-separated — production and preview origins can coexist.
FRONTEND_ORIGIN=http://localhost:5173

# Frankly's model-backed features (NL capture, Ask Frankly, the AI daily note) are the
# only ones that cost Anthropic API usage, so they ship off and show as "coming
# soon". Both of these must be set to switch them on.
LLM_ENABLED=false
ANTHROPIC_API_KEY=

# --- Production only -------------------------------------------------------
# Set ENV=prod and a real SECRET_KEY (`openssl rand -hex 32`) — the app refuses
# to boot in prod on the dev secret above.
#
# COOKIE_SAMESITE governs the refresh cookie. Leave it "lax" when the app and
# API share a registrable domain (frankly.app + api.frankly.app). Set "none"
# only when they don't (*.vercel.app + *.onrender.com) — otherwise the browser
# drops the cookie and every page reload signs the user out. "none" requires
# ENV=prod, because SameSite=None is only valid on a Secure cookie.
# COOKIE_SAMESITE=lax
#
# Per-IP throttling on /auth/register and /auth/login. On by default.
# RATE_LIMIT_ENABLED=true
