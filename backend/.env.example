# Copy to .env for local development. All values below are dev defaults.
ENV=dev
DATABASE_URL=postgresql+psycopg://frank:frank@localhost:5433/frank
SECRET_KEY=dev-secret-change-me-in-production-please
FRONTEND_ORIGIN=http://localhost:5173

# Frankly's model-backed features (NL capture, Ask Frankly, the AI daily note) are the
# only ones that cost Anthropic API usage, so they ship off and show as "coming
# soon". Both of these must be set to switch them on.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
