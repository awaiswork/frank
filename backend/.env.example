# Copy to .env for local development. All values below are dev defaults.
ENV=dev
DATABASE_URL=postgresql+psycopg://frank:frank@localhost:5433/frank
SECRET_KEY=dev-secret-change-me-in-production-please
# Comma-separated — production and preview origins can coexist.
FRONTEND_ORIGIN=http://localhost:5173

# Frankly's model-backed features (NL capture, Ask Frankly, the AI daily note) are the
# only ones that cost Anthropic API usage, so they ship off and show as "coming
# soon". Both of these must be set to switch them on.
LLM_ENABLED=false
ANTHROPIC_API_KEY=

# --- Production only -------------------------------------------------------
# Set ENV=prod and a real SECRET_KEY (`openssl rand -hex 32`) — the app refuses
# to boot in prod on the dev secret above.
#
# COOKIE_SAMESITE governs the refresh cookie. Leave it "lax" when the app and
# API share a registrable domain (askfrankly.app + api.askfrankly.app). Set "none"
# only when they don't (*.vercel.app + *.onrender.com) — otherwise the browser
# drops the cookie and every page reload signs the user out. "none" requires
# ENV=prod, because SameSite=None is only valid on a Secure cookie.
# COOKIE_SAMESITE=lax
#
# Per-IP throttling on /auth/register and /auth/login. On by default.
# RATE_LIMIT_ENABLED=true

# --- Email -------------------------------------------------------------------
# `console` (default) prints the message, including the code, and sends nothing.
# That is the development path, and it is also a trap: leaving this unset in a
# deployed environment is not an error anywhere. The API boots, /healthz passes,
# /auth/register answers 202 "Check your email for a code", and the code goes to
# the server log. If mail is not arriving, read this and the two below before
# debugging anything else.
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER is not `console` — but NOT fatal if missing. The
# app logs `email_disabled` at boot and degrades to the console sender, because
# refusing to boot over email would take transactions and budgets down with it.
EMAIL_API_KEY=
# Who the mail is from, and the setting that decides who can RECEIVE it. This is
# the one that shipped wrong: production sent from the shared fallback below for
# a release, which meant codes reached exactly one mailbox and every other signup
# failed with 403 validation_error and no visible symptom.
#
# Production sends from the verified domain, which delivers to anyone:
#   EMAIL_FROM=Frankly <noreply@askfrankly.app>
# The shared fallback needs no domain, but Resend accepts no other sender AND
# delivers only to the address on your own Resend account. Fine for poking at a
# real send locally, useless for anyone else — never deploy it.
EMAIL_FROM=Frankly <onboarding@resend.dev>

# --- Google sign-in -----------------------------------------------------------
# Optional. Empty means the routes 404 and the button is hidden, so the app runs
# fine without it. Basic scopes only (openid/email/profile), which need no Google
# review and no domain — which is why this is the sign-up path that works for
# people other than you while Resend is limited to one address.
# Console → APIs & Services → Credentials → OAuth client ID → Web application.
# Authorised redirect URIs must include, exactly:
#   http://localhost:8000/auth/google/callback
#   https://frankly-api-8d2s.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
